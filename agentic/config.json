{
  "model": "gemini-3.1-flash-lite",
  "model_fallback": false,
  "budgets": {
    "model_calls": 4,
    "forgery_retries": 1,
    "wall_seconds": 180,
    "tasks": 20,
    "sandbox_seconds": 180,
    "react_turns": 6,
    "tool_output_chars": 4000
  },
  "rag": {
    "k": 3,
    "repo_graph": true,
    "record": true
  },
  "repair": {
    "trip_after": 2
  },
  "loop": {
    "same_action": 2,
    "same_failure": 2,
    "no_progress": 3
  },
  "sandbox": "sandbox/",
  "mandatory_checks": ["sandbox"],
  "allowed_kinds": ["read", "compute"]
}
