# Visual Culture Research Platform (magref) -- configuration.
# Copy to .env (read automatically from the current directory) or pass --env-file.
# Environment variables override the file; CLI flags override both.
# No API keys are required. Do not put secrets in this file.

# Data root. Holds images/, thumbnails/, database/, manifests/, exports/, logs/, tmp/, quarantine/.
# VC_ARCHIVE_DIR and MAGREF_DATA_DIR are the same setting (MAGREF_DATA_DIR wins if both are set).
# Default: ~/visual_culture_archive
VC_ARCHIVE_DIR=~/visual_culture_archive
# MAGREF_DATA_DIR=/data/magazine_refs

# SQLite file. Default: <data root>/database/references.sqlite3
# MAGREF_DB_PATH=

# Identify yourself to the sites you collect from (put a real contact before any live run).
MAGREF_USER_AGENT=magref/0.1 (+magazine reference research; contact: you@example.org)

# Network behaviour
MAGREF_TIMEOUT=15                 # seconds per request
MAGREF_REQUEST_INTERVAL=2         # min seconds between requests to one host (robots Crawl-delay wins if larger)
MAGREF_MAX_RETRIES=2              # retries after the first attempt, transient errors only (408/429/5xx/timeouts)
MAGREF_BACKOFF_BASE=1             # seconds, doubled per retry
MAGREF_MAX_RETRY_AFTER=60         # give up instead of honouring a longer Retry-After
MAGREF_MAX_CONCURRENCY=2          # page-crawl worker threads
MAGREF_MAX_PAGE_BYTES=5000000     # pages, feeds, sitemaps, catalogs
MAGREF_MAX_PAGES_PER_RUN=200      # default cap for discover/crawl

# Image downloads (only items whose effective policy is 'allowed')
MAGREF_MAX_FILE_BYTES=20000000            # per image file
MAGREF_MAX_DOWNLOADS_PER_RUN=20           # default --limit for download/retry
MAGREF_MAX_TOTAL_BYTES_PER_RUN=200000000  # default --max-bytes for download/retry

# Image measurement during page crawl:
#   off     no image bytes are read
#   header  read at most MAGREF_IMAGE_HEADER_BYTES per image to measure width/height (default)
#   colors  for 'allowed' sources, read up to MAGREF_IMAGE_MAX_BYTES of the primary image and
#           measure dominant colours (requires Pillow); nothing is written to disk
MAGREF_IMAGE_MODE=header
MAGREF_IMAGE_HEADER_BYTES=65536
MAGREF_IMAGE_MAX_BYTES=3000000
MAGREF_IMAGES_PER_PAGE=3

MAGREF_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# Offline mode: serve every HTTP request from this directory (same as --fixtures).
# MAGREF_FIXTURE_DIR=fixtures/web

# TEST ONLY. Permits 127.0.0.1/::1 so tests can use a local HTTP server.
# Private ranges, link-local and cloud metadata addresses stay blocked regardless.
MAGREF_ALLOW_LOOPBACK=0
